{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Aimino-Tech/fast-html-mcp",
  "title": "Fast HTML MCP",
  "description": "Lightning-fast HTML generation from AI agents with tools, components, and templates.",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@surfsense/fast-html-mcp",
      "version": "0.1.0",
      "transport": { "type": "stdio" }
    }
  ],
  "deployment": {
    "type": "sse",
    "description": "Self-hosted MCP server via SSE transport with health and metrics endpoints.",
    "endpoints": {
      "health": "/health",
      "metrics": "/metrics",
      "sse": "/mcp/sse",
      "message": "/mcp/message"
    },
    "env": {
      "TRANSPORT": "sse",
      "PORT": "3000"
    }
  },
  "categories": ["developer-tools", "web-development", "content-generation"]
}
