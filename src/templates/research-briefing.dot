<!DOCTYPE html>
<html lang="en" data-theme="{{=it.theme || 'dark'}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Research Briefing'}}</title>
<style>
  :root {
    --bg-primary: #0a0f0f; --bg-secondary: #121a1a; --bg-card: #1a2a28;
    --border: #2a4440; --text-primary: #e0f0ec; --text-secondary: #90b0a8;
    --accent: #14b8a6; --accent-green: #34d399; --accent-amber: #fbbf24;
    --accent-red: #f87171; --accent-blue: #60a5fa;
    --font-body: 'Inter', system-ui, sans-serif; --font-mono: 'JetBrains Mono', 'SF Mono', monospace;
    --radius: 10px; --shadow: 0 4px 24px rgba(0,0,0,0.4);
    {{~it.css_vars :val:key}}{{=key}}: {{=val}};{{~}}
  }
  [data-theme="light"] {
    --bg-primary: #ecfdf5; --bg-secondary: #ffffff; --bg-card: #ffffff;
    --border: #a7d4c8; --text-primary: #134e4a; --text-secondary: #5a7a72;
    --accent: #0d9488; --accent-green: #059669; --accent-amber: #d97706;
    --accent-red: #dc2626; --accent-blue: #2563eb;
    --shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  body {
    font-family: var(--font-body); background: var(--bg-primary); color: var(--text-primary);
    max-width: {{=it.line_width || 900}}px; margin: 0 auto; padding: 40px 24px;
    line-height: 1.7; font-size: 15px;
  }
  h1, h2, h3, h4 { color: var(--accent); margin-top: 1.5em; margin-bottom: 0.5em; }
  h1 { font-size: 26px; font-weight: 800; }
  h2 { font-size: 20px; font-weight: 700; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  h3 { font-size: 16px; font-weight: 600; }
  .tldr-box { padding: 16px 20px; background: var(--bg-card); border: 2px solid var(--accent); border-radius: var(--radius); margin-bottom: 24px; }
  .tldr-box h3 { margin-top: 0; display: flex; align-items: center; gap: 8px; }
  .tldr-box h3::before { content: 'TL;DR'; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 2px 8px; border-radius: 4px; background: var(--accent); color: var(--bg-primary); }
  .findings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin: 16px 0; }
  .finding-card { padding: 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); position: relative; }
  .finding-card h4 { margin: 0 0 6px; font-size: 15px; padding-right: 60px; }
  .finding-card p { font-size: 13px; color: var(--text-secondary); margin: 0; }
  .confidence { position: absolute; top: 12px; right: 12px; padding: 2px 8px; border-radius: 100px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
  .confidence.high { background: rgba(52,211,153,0.15); color: var(--accent-green); }
  .confidence.med { background: rgba(251,191,36,0.15); color: var(--accent-amber); }
  .confidence.low { background: rgba(248,113,113,0.15); color: var(--accent-red); }
  .gap-section { padding: 16px; background: var(--bg-card); border: 1px dashed var(--border); border-radius: var(--radius); margin: 16px 0; }
  .gap-section h3 { margin-top: 0; }
  .gap-section li { font-size: 14px; color: var(--text-secondary); margin-bottom: 6px; }
  .methodology-box { padding: 16px 20px; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); border-left: 4px solid var(--accent-blue); margin: 16px 0; }
  .methodology-box h3 { margin-top: 0; color: var(--accent-blue); }
  .methodology-box p { font-size: 13px; color: var(--text-secondary); }
  .data-sources table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px; }
  .data-sources th { padding: 10px 14px; text-align: left; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); border-bottom: 2px solid var(--border); background: var(--bg-secondary); }
  .data-sources td { padding: 10px 14px; border-bottom: 1px solid var(--border); }
  .data-sources tr:nth-child(even) td { background: var(--bg-secondary); }
  .timeline-markers { position: relative; padding: 16px 0; margin: 16px 0; }
  .timeline-markers::before { content: ''; position: absolute; left: 20px; top: 0; bottom: 0; width: 2px; background: var(--accent); }
  .tm-item { position: relative; padding-left: 50px; margin-bottom: 20px; }
  .tm-item::before { content: ''; position: absolute; left: 14px; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 3px solid var(--bg-primary); }
  .tm-item .date { font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); }
  .tm-item h4 { margin: 2px 0; font-size: 15px; }
  .tm-item p { margin: 0; font-size: 13px; color: var(--text-secondary); }
  @media print { body { padding: 0; font-size: 12px; } .findings-grid { break-inside: avoid; } .confidence { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
{{=it.content}}
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
