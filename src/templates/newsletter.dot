<!DOCTYPE html>
<html lang="en" data-theme="{{=it.theme || 'light'}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Newsletter'}}</title>
<style>
  :root {
    --bg-primary: #ffffff; --bg-secondary: #f9fafb; --bg-card: #ffffff;
    --border: #e5e7eb; --text-primary: #111827; --text-secondary: #6b7280;
    --accent: #e11d48; --accent-light: #ffe4e6;
    --font-body: system-ui, -apple-system, sans-serif;
    --radius: 8px;
    {{~it.css_vars :val:key}}{{=key}}: {{=val}};{{~}}
  }
  [data-theme="dark"] {
    --bg-primary: #111827; --bg-secondary: #1f2937; --bg-card: #1f2937;
    --border: #374151; --text-primary: #f9fafb; --text-secondary: #9ca3af;
    --accent: #f43f5e; --accent-light: #4c0519;
  }
  body {
    font-family: var(--font-body); background: var(--bg-secondary); color: var(--text-primary);
    line-height: 1.6; margin: 0; padding: 0;
  }
  .nl-wrapper { max-width: {{=it.line_width || 640}}px; margin: 0 auto; background: var(--bg-primary); }
  .nl-header { text-align: center; padding: 40px 24px 24px; border-bottom: 1px solid var(--border); }
  .nl-header .logo { font-size: 24px; font-weight: 800; color: var(--accent); letter-spacing: -0.5px; }
  .nl-header .tagline { font-size: 14px; color: var(--text-secondary); margin-top: 4px; }
  .nl-hero { padding: 32px 24px; text-align: center; background: var(--accent-light); }
  .nl-hero h1 { font-size: 28px; font-weight: 700; margin: 0 0 8px; }
  .nl-hero p { font-size: 15px; color: var(--text-secondary); max-width: 480px; margin: 0 auto; }
  .nl-hero .badge { display: inline-block; padding: 4px 12px; border-radius: 100px; background: var(--accent); color: #fff; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }
  .nl-content { padding: 32px 24px; }
  .nl-content h2 { font-size: 20px; font-weight: 700; margin: 28px 0 12px; color: var(--text-primary); }
  .nl-content p { font-size: 15px; color: var(--text-secondary); margin: 0 0 16px; }
  .article-card { padding: 20px 0; border-bottom: 1px solid var(--border); }
  .article-card:last-child { border-bottom: none; }
  .article-card .cat { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--accent); font-weight: 600; }
  .article-card h3 { font-size: 18px; font-weight: 600; margin: 4px 0 8px; }
  .article-card p { font-size: 14px; color: var(--text-secondary); margin: 0; }
  .article-card .read-more { display: inline-block; margin-top: 8px; font-size: 13px; font-weight: 600; color: var(--accent); text-decoration: none; }
  .nl-footer { text-align: center; padding: 32px 24px; border-top: 1px solid var(--border); font-size: 13px; color: var(--text-secondary); }
  .nl-footer .social { display: flex; justify-content: center; gap: 16px; margin-bottom: 16px; }
  .nl-footer .social a { color: var(--text-secondary); text-decoration: none; font-size: 14px; }
  .nl-footer .social a:hover { color: var(--accent); }
  .nl-footer .unsub { font-size: 12px; color: var(--text-secondary); }
  @media (max-width: 600px) { .nl-hero { padding: 24px 16px; } .nl-content { padding: 24px 16px; } }
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
<div class="nl-wrapper">
{{=it.content}}
</div>
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
