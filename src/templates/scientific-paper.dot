<!DOCTYPE html>
<html lang="en" data-theme="{{=it.theme || 'dark'}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Scientific Paper'}}</title>
<style>
  :root {
    --bg-primary: #0f0f1a; --bg-secondary: #16162a; --bg-card: #1c1c38;
    --border: #2a2a50; --text-primary: #e8e8f0; --text-secondary: #9898c8;
    --accent: #38bdf8; --accent-dim: #1e3a5f; --accent-green: #4ade80; --accent-amber: #fbbf24;
    --font-body: 'Inter', system-ui, -apple-system, sans-serif; --font-mono: 'JetBrains Mono', 'SF Mono', monospace;
    --radius: 10px;
    {{~it.css_vars :val:key}}{{=key}}: {{=val}};{{~}}
  }
  [data-theme="light"] {
    --bg-primary: #ffffff; --bg-secondary: #f0f4f8; --bg-card: #ffffff;
    --border: #cbd5e1; --text-primary: #0f172a; --text-secondary: #475569;
    --accent: #0284c7; --accent-dim: #e0f2fe;
  }
  body { font-family: var(--font-body); background: var(--bg-primary); color: var(--text-primary); max-width: {{=it.line_width || 820}}px; margin: 0 auto; padding: 40px 24px; line-height: 1.7; font-size: 15px; }
  .paper-header { text-align: center; margin-bottom: 40px; padding-bottom: 30px; border-bottom: 2px solid var(--accent); }
  .paper-header h1 { font-size: 28px; font-weight: 800; margin: 0 0 12px; letter-spacing: -.5px; }
  .paper-header .authors { font-size: 14px; color: var(--text-secondary); }
  .paper-header .authors strong { color: var(--accent); }
  .paper-header .meta { font-size: 13px; color: var(--text-secondary); margin-top: 8px; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }
  .paper-header .doi-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; background: var(--accent-dim); color: var(--accent); font-family: var(--font-mono); }
  .paper-header .keywords { margin-top: 10px; display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; }
  .paper-header .keywords span { padding: 2px 10px; border-radius: 12px; font-size: 12px; background: var(--bg-card); border: 1px solid var(--border); color: var(--accent); }
  .abstract-box { background: var(--bg-card); border-left: 4px solid var(--accent); border-radius: 0 var(--radius) var(--radius) 0; padding: 20px 24px; margin-bottom: 32px; }
  .abstract-box h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); margin: 0 0 10px; }
  .abstract-box p { font-size: 14px; font-style: italic; margin: 0; color: var(--text-secondary); line-height: 1.8; }
  h2 { font-size: 20px; font-weight: 700; margin: 36px 0 16px; color: var(--accent); counter-increment: section; }
  h2::before { content: counter(section) ". "; }
  h3 { font-size: 16px; font-weight: 600; margin: 24px 0 12px; color: var(--text-primary); }
  body { counter-reset: section; }
  .fig-caption, .table-caption { font-size: 12px; color: var(--text-secondary); text-align: center; margin: 6px 0 20px; font-style: italic; }
  .fig-caption strong, .table-caption strong { font-weight: 600; color: var(--accent); }
  .eq-block { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 20px; margin: 16px 0; text-align: center; font-family: var(--font-mono); font-size: 14px; overflow-x: auto; }
  .eq-block .eq-num { float: right; color: var(--text-secondary); font-family: var(--font-body); font-size: 12px; }
  table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 13px; }
  table th { padding: 8px 12px; text-align: left; font-weight: 600; border-bottom: 2px solid var(--accent); background: var(--bg-secondary); color: var(--accent); }
  table td { padding: 8px 12px; border-bottom: 1px solid var(--border); }
  .ref-list { list-style: none; padding: 0; font-size: 13px; }
  .ref-list li { padding: 8px 12px; border-left: 2px solid var(--border); margin-bottom: 6px; color: var(--text-secondary); }
  .ref-list li .ref-num { color: var(--accent); font-weight: 700; font-family: var(--font-mono); margin-right: 8px; }
  .ref-list li:hover { border-left-color: var(--accent); }
  @media print { body { padding: 0; font-size: 12px; } h2 { page-break-before: always; } h2:first-of-type { page-break-before: avoid; } .paper-header { page-break-after: avoid; } }
  @media (max-width: 640px) { .paper-header h1 { font-size: 22px; } body { padding: 24px 16px; } }
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
{{=it.content}}
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
