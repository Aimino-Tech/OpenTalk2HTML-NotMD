<!DOCTYPE html>
<html lang="en" data-theme="{{=it.theme || 'dark'}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Exploration'}}</title>
<style>
  :root {
    --bg-primary: #0a0a0f; --bg-secondary: #0f0f1a; --bg-card: #161625;
    --border: #2a2a3a; --text-primary: #e8e8f0; --text-secondary: #8888b0;
    --accent: #60a5fa; --font-body: 'Inter', sans-serif; --font-mono: 'JetBrains Mono', monospace;
    {{~it.css_vars :val:key}}{{=key}}: {{=val}};{{~}}
  }
  [data-theme="light"] {
    --bg-primary: #f8fafc; --bg-secondary: #ffffff; --bg-card: #ffffff;
    --border: #d0d5dd; --text-primary: #1a1a2e; --text-secondary: #667085;
    --accent: #2563eb;
  }
  body {
    font-family: var(--font-body); background: var(--bg-primary); color: var(--text-primary);
    max-width: {{=it.line_width || 1000}}px; margin: 0 auto; padding: 40px 24px;
  }
  {{=it.custom_css || ''}}
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
{{=it.content}}
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
