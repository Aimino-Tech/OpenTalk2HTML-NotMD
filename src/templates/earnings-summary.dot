<!DOCTYPE html>
<html lang="en" data-theme="{{=it.theme || 'dark'}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Earnings Summary'}}</title>
<style>
  :root {
    --bg-primary: #0f0f1a; --bg-secondary: #181830; --bg-card: #1e1e3a;
    --border: #2e2e58; --text-primary: #e8e8f0; --text-secondary: #9898c8;
    --accent: #818cf8; --accent-dim: #1e1e50; --accent-green: #4ade80; --accent-red: #f87171; --accent-amber: #fbbf24;
    --font-body: 'Inter', system-ui, -apple-system, sans-serif; --font-mono: 'JetBrains Mono', 'SF Mono', monospace;
    --radius: 10px;
    {{~it.css_vars :val:key}}{{=key}}: {{=val}};{{~}}
  }
  [data-theme="light"] {
    --bg-primary: #f8f9ff; --bg-secondary: #ffffff; --bg-card: #ffffff;
    --border: #d8dae8; --text-primary: #0f0f2a; --text-secondary: #5a5a8a;
    --accent: #6366f1; --accent-dim: #eef2ff;
  }
  body { font-family: var(--font-body); background: var(--bg-primary); color: var(--text-primary); max-width: {{=it.line_width || 900}}px; margin: 0 auto; padding: 40px 24px; line-height: 1.5; }
  .earnings-header { margin-bottom: 28px; padding-bottom: 20px; border-bottom: 2px solid var(--accent); display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; }
  .earnings-header h1 { font-size: 26px; font-weight: 700; margin: 0; }
  .earnings-header .sub { font-size: 14px; color: var(--text-secondary); }
  .eps-badge { display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 14px; font-weight: 700; font-family: var(--font-mono); }
  .eps-badge.beat { background: rgba(74,222,128,.12); color: var(--accent-green); border: 1px solid var(--accent-green); }
  .eps-badge.miss { background: rgba(248,113,113,.12); color: var(--accent-red); border: 1px solid var(--accent-red); }
  .eps-badge.inline { background: rgba(251,191,36,.12); color: var(--accent-amber); border: 1px solid var(--accent-amber); }
  .fin-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin-bottom: 28px; }
  .fin-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; }
  .fin-card .label { font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: var(--text-secondary); font-weight: 600; }
  .fin-card .value { font-size: 22px; font-weight: 800; font-family: var(--font-mono); margin: 4px 0; letter-spacing: -1px; }
  .fin-card .change { font-size: 13px; display: flex; align-items: center; gap: 4px; }
  .fin-card .change.up { color: var(--accent-green); }
  .fin-card .change.down { color: var(--accent-red); }
  .yo-arrow { display: inline-block; font-size: 12px; margin-right: 2px; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 24px; font-size: 13px; }
  table th { padding: 10px 14px; text-align: left; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: var(--text-secondary); border-bottom: 2px solid var(--border); background: var(--bg-secondary); }
  table td { padding: 10px 14px; border-bottom: 1px solid var(--border); }
  table td.amt { text-align: right; font-family: var(--font-mono); font-weight: 600; }
  table td.pos { color: var(--accent-green); }
  table td.neg { color: var(--accent-red); }
  .seg-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; margin-bottom: 14px; }
  .seg-card .seg-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .seg-card .seg-header h3 { margin: 0; font-size: 15px; font-weight: 600; }
  .seg-card .seg-header .seg-rev { font-family: var(--font-mono); font-weight: 700; font-size: 16px; }
  .seg-bar { height: 6px; border-radius: 3px; background: var(--bg-secondary); margin: 8px 0; overflow: hidden; }
  .seg-bar .fill { height: 100%; border-radius: 3px; background: var(--accent); }
  .guidance-box { background: var(--bg-card); border: 1px solid var(--accent); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 24px; }
  .guidance-box h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); margin: 0 0 10px; }
  .guidance-box .guidance-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; border-bottom: 1px solid var(--border); }
  .guidance-box .guidance-row:last-child { border-bottom: none; }
  .guidance-box .guidance-row .label { color: var(--text-secondary); }
  .guidance-box .guidance-row .value { font-weight: 700; font-family: var(--font-mono); }
  .source-tag { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; margin-right: 4px; }
  .source-tag.sec { background: rgba(129,140,248,.15); color: var(--accent); }
  .source-tag.consensus { background: rgba(251,191,36,.15); color: var(--accent-amber); }
  .source-tag.guidance { background: rgba(74,222,128,.15); color: var(--accent-green); }
  .qa-highlight { padding: 12px 16px; border-left: 3px solid var(--accent); margin-bottom: 8px; background: var(--bg-card); border-radius: 0 var(--radius) var(--radius) 0; font-size: 14px; }
  .qa-highlight .qa-q { font-weight: 700; margin-bottom: 4px; color: var(--accent); }
  .qa-highlight .qa-a { color: var(--text-secondary); }
  @media print { body { padding: 0; } }
  @media (max-width: 640px) { .fin-grid { grid-template-columns: 1fr 1fr; } }
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
{{=it.content}}
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
