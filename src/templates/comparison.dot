<!DOCTYPE html>
<html lang="en" data-theme="{{=it.theme || 'light'}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Comparison'}}</title>
<style>
  :root {
    --bg-primary: #ffffff; --bg-secondary: #f8fafc; --bg-card: #ffffff;
    --border: #e2e8f0; --text-primary: #0f172a; --text-secondary: #64748b;
    --accent: #2563eb; --accent-light: #eff6ff; --accent-green: #16a34a; --accent-red: #dc2626;
    --font-body: system-ui, -apple-system, sans-serif; --font-mono: 'SF Mono', 'Fira Code', monospace;
    --radius: 8px;
    {{~it.css_vars :val:key}}{{=key}}: {{=val}};{{~}}
  }
  [data-theme="dark"] {
    --bg-primary: #0f172a; --bg-secondary: #1e293b; --bg-card: #1e293b;
    --border: #334155; --text-primary: #f1f5f9; --text-secondary: #94a3b8;
    --accent: #3b82f6; --accent-light: #1e3a5f; --accent-green: #22c55e; --accent-red: #ef4444;
  }
  body {
    font-family: var(--font-body); background: var(--bg-primary); color: var(--text-primary);
    max-width: {{=it.line_width || 1000}}px; margin: 0 auto; padding: 32px 24px;
    line-height: 1.5;
  }
  .comp-header { margin-bottom: 32px; }
  .comp-header h1 { font-size: 26px; font-weight: 700; margin: 0 0 8px; }
  .comp-header p { color: var(--text-secondary); margin: 0; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 32px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  table th { padding: 14px 16px; text-align: left; font-weight: 600; font-size: 13px; border-bottom: 2px solid var(--border); background: var(--bg-secondary); }
  table th:first-child { position: sticky; left: 0; background: var(--bg-secondary); z-index: 1; }
  table th.highlight { background: var(--accent-light); color: var(--accent); }
  table td { padding: 12px 16px; border-bottom: 1px solid var(--border); }
  table td:first-child { font-weight: 600; position: sticky; left: 0; background: var(--bg-primary); z-index: 1; }
  table tr:hover td { background: var(--bg-secondary); }
  table tr:hover td:first-child { background: var(--bg-secondary); }
  table td.highlight { background: var(--accent-light); }
  table td .check { color: var(--accent-green); font-weight: 700; }
  table td .cross { color: var(--accent-red); }
  table td .partial { color: var(--accent); }
  .comp-footer { font-size: 13px; color: var(--text-secondary); text-align: center; }
  @media (max-width: 768px) { body { padding: 24px 16px; } table { font-size: 13px; } table th, table td { padding: 10px 12px; } }
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
{{=it.content}}
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
