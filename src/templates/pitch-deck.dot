<!DOCTYPE html>
<html lang="en" data-theme="{{=it.theme || 'dark'}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Pitch Deck'}}</title>
<style>
  :root {
    --bg-primary: #0f172a; --bg-secondary: #1e293b; --bg-card: #1e293b;
    --border: #334155; --text-primary: #f1f5f9; --text-secondary: #94a3b8;
    --accent: #8b5cf6; --accent-light: #1e1b4b; --accent-bright: #a78bfa;
    --green: #22c55e; --red: #ef4444; --amber: #f59e0b; --blue: #3b82f6;
    --font-body: system-ui, -apple-system, sans-serif; --font-display: system-ui, -apple-system, sans-serif;
    --radius: 12px; --shadow: 0 4px 24px rgba(0,0,0,0.3);
    {{~it.css_vars :val:key}}{{=key}}: {{=val}};{{~}}
  }
  [data-theme="light"] {
    --bg-primary: #ffffff; --bg-secondary: #f8fafc; --bg-card: #ffffff;
    --border: #e2e8f0; --text-primary: #0f172a; --text-secondary: #64748b;
    --accent: #7c3aed; --accent-light: #f5f3ff; --accent-bright: #6d28d9;
    --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb;
    --shadow: 0 4px 24px rgba(0,0,0,0.08);
  }
  body {
    font-family: var(--font-body); color: var(--text-primary);
    line-height: 1.6; margin: 0; background: var(--bg-primary);
  }
  .slide { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 80px 48px; max-width: 1000px; margin: 0 auto; border-bottom: 1px solid var(--border); }
  .slide:last-child { border-bottom: none; }
  .slide h1 { font-size: clamp(36px, 5vw, 56px); font-weight: 800; letter-spacing: -2px; margin: 0 0 16px; line-height: 1.1; }
  .slide h2 { font-size: 28px; font-weight: 700; margin: 0 0 24px; letter-spacing: -1px; }
  .slide .subtitle { font-size: 18px; color: var(--text-secondary); max-width: 700px; margin-bottom: 32px; }
  .slide .badge { display: inline-block; padding: 6px 16px; border-radius: 100px; background: var(--accent-light); color: var(--accent-bright); font-size: 13px; font-weight: 600; margin-bottom: 20px; border: 1px solid var(--accent); }
  .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 24px; margin: 32px 0; }
  .stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; text-align: center; box-shadow: var(--shadow); }
  .stat-card .value { font-size: 32px; font-weight: 800; color: var(--accent-bright); letter-spacing: -1px; }
  .stat-card .label { font-size: 13px; color: var(--text-secondary); margin-top: 4px; }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin: 24px 0; }
  .feature-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); }
  .feature-card .icon { font-size: 28px; margin-bottom: 12px; display: block; }
  .feature-card h3 { font-size: 16px; font-weight: 700; margin: 0 0 8px; }
  .feature-card p { font-size: 14px; color: var(--text-secondary); margin: 0; }
  .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin: 24px 0; }
  .team-card { text-align: center; padding: 24px; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .team-card .avatar { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent-bright)); margin: 0 auto 12px; display: flex; align-items: center; justify-content: center; font-size: 28px; color: #fff; font-weight: 700; }
  .team-card h4 { margin: 0; font-size: 15px; font-weight: 600; }
  .team-card .role { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }
  .slide-nav { position: fixed; bottom: 24px; right: 24px; display: flex; gap: 8px; z-index: 100; }
  .slide-nav button { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-primary); cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
  .slide-nav button:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
  .slide-progress { position: fixed; top: 0; left: 0; height: 3px; background: var(--accent); z-index: 100; transition: width 0.3s; }
  @media (max-width: 768px) { .slide { padding: 60px 24px; } .stats-row { grid-template-columns: 1fr 1fr; } .features-grid { grid-template-columns: 1fr; } }
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
<div class="slide-progress" id="slideProgress"></div>
{{=it.content}}
<div class="slide-nav">
  <button onclick="window.scrollTo({top: Math.max(0, window.scrollY - window.innerHeight), behavior:'smooth'})" id="prevSlide">&#8593;</button>
  <button onclick="window.scrollTo({top: window.scrollY + window.innerHeight, behavior:'smooth'})" id="nextSlide">&#8595;</button>
</div>
<script>
(function(){var s=document.getElementById('slideProgress');if(!s)return;var u=function(){var t=document.documentElement.scrollTop,h=document.documentElement.scrollHeight-document.documentElement.clientHeight;s.style.width=(t/h*100)+'%'};window.addEventListener('scroll',u,{passive:true});u()})();
</script>
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
