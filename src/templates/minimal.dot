<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Document'}}</title>
<style>
  body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: {{=it.line_width || 800}}px; margin: 0 auto; padding: 20px; }
  {{=it.custom_css || ''}}
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
{{=it.content}}
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
