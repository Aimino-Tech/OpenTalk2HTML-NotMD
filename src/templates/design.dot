<!DOCTYPE html>
<html lang="en" data-theme="{{=it.theme || 'dark'}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{=it.title || 'Design'}}</title>
<style>
  :root {
    --bg-primary: #0a0a12; --bg-card: #161622; --bg-elevated: #1e1e32;
    --border: #2a2a44; --text-primary: #e8e8f0; --text-secondary: #9898b8;
    --accent: #f472b6; --font-body: 'Inter', sans-serif; --font-mono: 'JetBrains Mono', monospace;
    {{~it.css_vars :val:key}}{{=key}}: {{=val}};{{~}}
  }
  [data-theme="light"] {
    --bg-primary: #fdf2f8; --bg-card: #ffffff; --bg-elevated: #fce7f3;
    --border: #f0d0e0; --text-primary: #1a1a2e; --text-secondary: #8a5a7a;
    --accent: #db2777;
  }
  body {
    font-family: var(--font-body); background: var(--bg-primary); color: var(--text-primary);
    max-width: {{=it.line_width || 1000}}px; margin: 0 auto; padding: 40px 24px;
  }
  {{=it.custom_css || ''}}
</style>
{{? it.inject_css }}<style>{{=it.inject_css}}</style>{{?}}
</head>
<body>
{{=it.content}}
{{? it.inject_js }}<script>{{=it.inject_js}}</script>{{?}}
</body>
</html>
